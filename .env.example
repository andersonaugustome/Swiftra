APP_NAME=Swiftra
APP_ENV=development
APP_URL=http://127.0.0.1:8080
APP_HOST=127.0.0.1
APP_PORT=8080
APP_TIMEZONE=UTC

DB_CONNECTION=sqlite
DB_PATH=swiftra.sqlite

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=swiftra
DB_USERNAME=root
DB_PASSWORD=
# disabled (local/docker) ou required (TLS verificado, produção)
DB_TLS=disabled

# Autenticação
AUTH_ACCESS_TOKEN_TTL_MINUTES=60
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_PASSWORD_RESET_TTL_MINUTES=60
AUTH_EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_MFA_CHALLENGE_TTL_MINUTES=5
AUTH_REQUIRE_VERIFIED_EMAIL=false
AUTH_DEFAULT_ROLE=user

# Rate limiting (tentativas por janela, por IP)
RATE_LIMIT_DRIVER=database
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_DECAY_SECONDS=60
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_DECAY_SECONDS=60

# Email: log (desenvolvimento) ou smtp (envio real)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=starttls
MAIL_FROM_ADDRESS=no-reply@swiftra.local
MAIL_FROM_NAME=Swiftra
